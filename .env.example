# Copy this file to ".env" (same folder as the script) and fill it in.
# Tip: use a dedicated VetBuddy login for the robot, so staff password changes don't break it.

VETBUDDY_USER=your_login_id
VETBUDDY_PASS=your_password

# Where the daily file goes. A shared/network or OneDrive/Google Drive-synced folder
# lets the whole team open it. Examples:
#   OUTPUT_DIR=\\fileserver\Reports\VetBuddy
#   OUTPUT_DIR=C:\Users\Public\VetBuddy Reports
OUTPUT_DIR=C:\VetBuddyReports

# true = keep only today's file in the folder; false = keep one file per day
KEEP_ONLY_LATEST=false

# --- SharePoint (optional for local runs; in GitHub these are secrets/variables) ---
SP_TENANT_ID=
SP_CLIENT_ID=
SP_CLIENT_SECRET=
SP_SITE_URL=https://sanchuhospital.sharepoint.com/sites/SalesTeam
SP_LIBRARY=Sales Reports Sanchu
SP_FOLDER=CRM Upload
SP_ARCHIVE_FOLDER=CRM Archive
SP_MASTER_PATH=Vetbuddy Master Data 2.xlsx

# --- Supabase database for the Teams bot (optional) ---
SUPABASE_DB_URL=
